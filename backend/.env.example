# Copy this file to backend/.env and paste ONE key after its = sign.
# backend/.env is ignored by git, so the key stays on your computer.
# If both keys are set, the Anthropic key is used.

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: a free model to try first, ending in :free. Paid models are refused.
# Left empty, ChemFlow picks free models itself and switches if one fails.
OPENROUTER_MODEL=

# Only needed when hosting:
# APP_PASSWORD=          asks visitors for a password
# ALLOWED_ORIGINS=       your frontend's address, for example https://chemflow.vercel.app
